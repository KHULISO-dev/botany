<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Field Observation Logger | Field Research Tool</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
            color: #222;
            background-color: #0e1916;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            min-height: 100%;
        }

        body {
            background: radial-gradient(circle at top, rgba(68, 192, 121, 0.16), transparent 35%),
                        linear-gradient(180deg, #0b1511 0%, #12211c 100%);
            color: #101f19;
            padding: 24px;
        }

        .container {
            max-width: 820px;
            margin: 0 auto;
        }

        .card {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(19, 64, 46, 0.12);
            border-radius: 32px;
            padding: 2rem;
            box-shadow: 0 28px 60px rgba(4, 20, 15, 0.22);
            margin-bottom: 24px;
        }

        .hero {
            text-align: center;
            margin-bottom: 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(31, 84, 61, 0.16);
        }

        .logo {
            max-width: 110px;
            margin: 0 auto 16px;
        }

        .logo svg {
            width: 100%;
            height: auto;
        }

        h1 {
            font-size: clamp(2rem, 2.5vw, 2.6rem);
            color: #16392c;
            letter-spacing: -0.03em;
            margin-bottom: 10px;
        }

        .sub {
            color: #3e6b55;
            font-weight: 500;
            font-size: 1rem;
            line-height: 1.6;
        }

        .project-badge {
            margin-top: 22px;
            padding: 16px 20px;
            border-radius: 28px;
            background: #edf7ef;
            color: #1f4d34;
            border: 1px solid #d7efe0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 0.95rem;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            color: #1f4236;
            font-size: 0.97rem;
        }

        input,
        textarea,
        select {
            width: 100%;
            border-radius: 24px;
            border: 1px solid #d7e8de;
            background: #ffffff;
            padding: 14px 16px;
            font-size: 1rem;
            color: #1f3d32;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        input:focus,
        textarea:focus,
        select:focus {
            border-color: #4f8f6d;
            box-shadow: 0 0 0 4px rgba(79, 143, 109, 0.12);
        }

        textarea {
            min-height: 96px;
            resize: vertical;
        }

        button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            border: none;
            border-radius: 28px;
            padding: 14px 18px;
            background: #1f5e3f;
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.18s ease, background 0.18s ease;
        }

        button:hover {
            background: #164a34;
            transform: translateY(-1px);
        }

        .form-group button {
            margin-top: 10px;
        }

        .secondary-button {
            background: #f1f7f2;
            color: #1f5e3f;
            box-shadow: inset 0 0 0 1px rgba(31, 94, 63, 0.12);
        }

        .secondary-button:hover {
            background: #e5efe7;
        }

        .photo-preview {
            margin-top: 14px;
            text-align: center;
        }

        .photo-preview img {
            max-width: 100%;
            max-height: 180px;
            border-radius: 24px;
            border: 1px solid #dbe9dd;
        }

        .observation-list {
            background: #fdfbf6;
            border-radius: 28px;
            padding: 18px;
            max-height: 500px;
            overflow-y: auto;
        }

        .obs-item {
            background: white;
            border-radius: 24px;
            padding: 18px;
            margin-bottom: 16px;
            border-left: 4px solid #4f8f6d;
            box-shadow: 0 6px 16px rgba(15, 35, 27, 0.06);
        }

        .obs-name {
            font-weight: 800;
            font-size: 1.15rem;
            color: #16392c;
        }

        .obs-meta {
            font-size: 0.86rem;
            color: #5b6c64;
            margin: 8px 0;
        }

        .btn-small {
            background: none;
            border: none;
            color: #b34e4e;
            font-size: 0.84rem;
            text-decoration: underline;
            padding: 0;
            cursor: pointer;
        }

        .btn-small:hover {
            color: #8a2f2f;
        }

        .flex-buttons {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        footer {
            text-align: center;
            color: #a3bfaf;
            font-size: 0.82rem;
            margin-top: 20px;
            line-height: 1.6;
        }

        #locationStatus {
            font-size: 0.9rem;
            color: #336a53;
            margin-top: 8px;
            min-height: 22px;
        }

        @media (max-width: 640px) {
            .flex-buttons {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 1.6rem;
            }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <div class="hero">
            <div class="logo">
                <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="45" fill="#1f543d" stroke="#cddfd2" stroke-width="2"/>
                    <text x="50" y="63" text-anchor="middle" fill="#cddfd2" font-size="18" font-weight="bold">FIELD</text>
                    <text x="50" y="82" text-anchor="middle" fill="#e8f1e9" font-size="8">Research</text>
                </svg>
            </div>
            <h1>Field Observation Logger</h1>
            <div class="sub">Capture plant data in the field with GPS, photos, offline storage, and export support.</div>
            <div class="project-badge">Ready for field research, ecological surveys, and mobile data collection.</div>
        </div>

        <div class="form-group">
            <label>🌱 Plant name *</label>
            <input type="text" id="plantName" placeholder="Scientific / Common name">
        </div>

        <div class="form-group">
            <label>📍 GPS coordinates</label>
            <input type="text" id="gps" placeholder="Click 'Get GPS' or type manually">
            <button id="getGpsBtn" class="secondary-button">📡 Get current location</button>
            <div id="locationStatus"></div>
        </div>

        <div class="form-group">
            <label>📝 Field notes (habit, habitat, phenology)</label>
            <textarea rows="2" id="notes" placeholder="e.g., Growing near stream, flowers pink, 1.5m tall"></textarea>
        </div>

        <div class="form-group">
            <label>📸 Take or upload photo</label>
            <input type="file" id="photoInput" accept="image/*" capture="environment">
            <div id="photoPreview" class="photo-preview"></div>
        </div>

        <button id="saveBtn">➕ SAVE OBSERVATION (offline storage)</button>

        <div class="flex-buttons">
            <button id="exportCsvBtn">📎 Export CSV</button>
            <button id="exportGeoJsonBtn">🗺️ Export GeoJSON</button>
            <button id="clearAllBtn">🗑️ Clear all data</button>
        </div>
    </div>

    <div class="card">
        <h3 style="margin-bottom: 12px;">📋 My observations</h3>
        <div id="observationList" class="observation-list">
            <div style="text-align:center; padding: 32px;">No observations yet. Add your first field record.</div>
        </div>
    </div>
    <footer>Secure field data storage on this device · export to CSV or GeoJSON for analysis.</footer>
</div>

<script>
    let observations = [];

    function loadData() {
        const stored = localStorage.getItem('field_observation_log');
        if (stored) observations = JSON.parse(stored);
        else observations = [];
        renderList();
    }

    function saveData() {
        localStorage.setItem('field_observation_log', JSON.stringify(observations));
        renderList();
    }

    function renderList() {
        const container = document.getElementById('observationList');
        if (!observations.length) {
            container.innerHTML = '<div style="text-align:center; padding: 32px;">🌱 No observations yet. Add your first plant.</div>';
            return;
        }
        let html = '';
        [...observations].reverse().forEach((obs, idx) => {
            const originalIdx = observations.length - 1 - idx;
            const date = new Date(obs.timestamp).toLocaleString();
            const photoHtml = obs.photoData ? `<img src="${obs.photoData}" style="max-width:80px; max-height:80px; border-radius:16px; margin-top:8px;">` : '';
            html += `
                <div class="obs-item">
                    <div class="obs-name">🌾 ${escapeHtml(obs.plantName)}</div>
                    <div class="obs-meta">📍 ${escapeHtml(obs.gps || 'no GPS')} &nbsp;|&nbsp; ${date}</div>
                    <div class="obs-meta">📝 ${escapeHtml(obs.notes || '—')}</div>
                    ${photoHtml}
                    <button class="btn-small" data-idx="${originalIdx}">🗑️ Remove</button>
                </div>
            `;
        });
        container.innerHTML = html;
        document.querySelectorAll('.btn-small').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const idx = parseInt(btn.dataset.idx);
                observations.splice(idx, 1);
                saveData();
            });
        });
    }

    function escapeHtml(str) { if(!str) return ''; return str.replace(/[&<>]/g, function(m){return m==='&'?'&amp;':m==='<'?'&lt;':'&gt;';}); }

    document.getElementById('getGpsBtn').addEventListener('click', () => {
        const statusDiv = document.getElementById('locationStatus');
        statusDiv.innerText = '📍 Requesting location...';
        if (!navigator.geolocation) {
            statusDiv.innerText = '❌ GPS not supported by this browser.';
            return;
        }
        navigator.geolocation.getCurrentPosition(
            (pos) => {
                const lat = pos.coords.latitude.toFixed(6);
                const lon = pos.coords.longitude.toFixed(6);
                const gpsString = `${lat}, ${lon}`;
                document.getElementById('gps').value = gpsString;
                statusDiv.innerText = `✅ GPS captured: ${gpsString}`;
            },
            (err) => {
                statusDiv.innerText = `⚠️ GPS error: ${err.message}. You can type coordinates manually.`;
            }
        );
    });

    let currentPhotoData = null;
    document.getElementById('photoInput').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (ev) => {
                currentPhotoData = ev.target.result;
                document.getElementById('photoPreview').innerHTML = `<img src="${currentPhotoData}" alt="preview">`;
            };
            reader.readAsDataURL(file);
        } else {
            currentPhotoData = null;
            document.getElementById('photoPreview').innerHTML = '';
        }
    });

    document.getElementById('saveBtn').addEventListener('click', () => {
        const plantName = document.getElementById('plantName').value.trim();
        if (!plantName) {
            alert('Please enter a plant name.');
            return;
        }
        const gps = document.getElementById('gps').value.trim();
        const notes = document.getElementById('notes').value.trim();
        const newObs = {
            id: Date.now(),
            plantName: plantName,
            gps: gps || 'not recorded',
            notes: notes || '',
            photoData: currentPhotoData || null,
            timestamp: new Date().toISOString()
        };
        observations.push(newObs);
        saveData();
        document.getElementById('plantName').value = '';
        document.getElementById('gps').value = '';
        document.getElementById('notes').value = '';
        document.getElementById('photoInput').value = '';
        currentPhotoData = null;
        document.getElementById('photoPreview').innerHTML = '';
        alert('Observation saved!');
    });

    document.getElementById('exportCsvBtn').addEventListener('click', () => {
        if (!observations.length) { alert('No data to export'); return; }
        let csv = [['PlantName','GPS_Coordinates','Notes','Timestamp'].join(',')];
        observations.forEach(obs => {
            csv.push([
                `"${obs.plantName.replace(/"/g, '""')}"`,
                `"${obs.gps.replace(/"/g, '""')}"`,
                `"${(obs.notes || '').replace(/"/g, '""')}"`,
                `"${obs.timestamp}"`
            ].join(','));
        });
        const blob = new Blob([csv.join('\n')], {type: 'text/csv'});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `field_observations_${new Date().toISOString().slice(0,19)}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
    });

    document.getElementById('exportGeoJsonBtn').addEventListener('click', () => {
        if (!observations.length) { alert('No data to export'); return; }
        const features = [];
        observations.forEach(obs => {
            let coords = null;
            const gpsStr = obs.gps;
            const match = gpsStr.match(/(-?\d+\.\d+),\s*(-?\d+\.\d+)/);
            if (match) {
                coords = [parseFloat(match[2]), parseFloat(match[1])];
            }
            features.push({
                type: 'Feature',
                geometry: coords ? { type: 'Point', coordinates: coords } : null,
                properties: {
                    name: obs.plantName,
                    notes: obs.notes,
                    timestamp: obs.timestamp
                }
            });
        });
        const geojson = { type: 'FeatureCollection', features: features };
        const blob = new Blob([JSON.stringify(geojson, null, 2)], {type: 'application/json'});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `field_observations_${new Date().toISOString().slice(0,19)}.geojson`;
        a.click();
        URL.revokeObjectURL(a.href);
    });

    document.getElementById('clearAllBtn').addEventListener('click', () => {
        if (confirm('⚠️ Delete ALL observations? This cannot be undone.')) {
            observations = [];
            saveData();
            alert('All data cleared.');
        }
    });

    loadData();
</script>
</body>
</html>
